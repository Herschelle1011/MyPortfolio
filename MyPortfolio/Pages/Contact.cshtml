@page
@model MyPortfolio.Pages.ContactModel
@{
	ViewData["Title"] = "Contact page";
}


<div class="page">
	<h1 class="current-page">CONTACT</h1>
	<hr class="thick-line">
</div>

<div class="contact-me-Content">
	<h1 class="contact-header">Contact Me</h1>
	<p class="contact-description">
		If you’d like to reach out, collaborate, or ask anything about my work, feel free to contact me. You can send me an email or message me directly through my number—I'm always open to inquiries, opportunities, and connecting with new people.
	</p>


	<div class="box-icons">
		<div class="box-elements">
		<div class="email">
		<i class="bi bi-envelope-fill"></i>
		<p>Herschelle101@gmail.com</p>
		</div>

		<div class="phone">
		<i class="bi bi-telephone-fill"></i><p>09096809637</p>
		</div>
	</div>
	</div>
</div>


<div class="message-box">
	<div class="elements">
	<p class="lblname">Name</p>
	<div class="input-icon">
		<i class="bi bi-person text-black person"></i>
		<input type="text" placeholder="Username" class="input-user">
	</div>

	<p class="lblEmail">Email</p>
	<div class="input-icon">
		<i class="bi bi-envelope text-black"></i>
			<input type="text" placeholder="Email" class="input-email">
	</div>

		<p class="lblPhone">Phone Number</p>
		<div class="input-icon">
			<i class="bi bi-telephone text-black"></i>
			<input type="text" placeholder="Phone Number" class="input-phone">
		</div>

		<p class="lblmessage">Message</p>
		<div class="input-icon">
		<textarea placeholder="Please write your message..." class="input-message"></textarea>
		</div>

		<button type="submit" class="btn btn-outline-primary submit">Submit</button>

	</div>
	
</div>







